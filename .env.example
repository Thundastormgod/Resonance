# ===========================================
# AI News Generator - Environment Variables
# ===========================================

# OpenRouter API (Required for AI generation, fact-checking, bias detection)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ===========================================
# News API Keys (Optional - enables premium sources)
# ===========================================

# NewsAPI.org - 80,000+ sources aggregator
# Get your key at: https://newsapi.org/register
NEWSAPI_KEY=your_newsapi_key_here

# The Guardian Open Platform
# Get your key at: https://open-platform.theguardian.com/access/
GUARDIAN_API_KEY=your_guardian_api_key_here

# New York Times API
# Get your key at: https://developer.nytimes.com/
NYTIMES_API_KEY=your_nytimes_api_key_here

# Mediastack - Real-time news API
# Get your key at: https://mediastack.com/
MEDIASTACK_KEY=your_mediastack_key_here

# ===========================================
# Sanity CMS Configuration
# ===========================================

# Sanity Project ID (Required)
VITE_SANITY_PROJECT_ID=your_sanity_project_id
SANITY_PROJECT_ID=your_sanity_project_id

# Sanity Dataset
VITE_SANITY_DATASET=production
SANITY_DATASET=production

# Sanity API Token (Required for publishing - needs write access)
# Get this from: https://www.sanity.io/manage/project/YOUR_PROJECT_ID/api#tokens
# Create a token with "Editor" permissions
SANITY_API_TOKEN=your_sanity_write_token_here

# Sanity Public Read Token (for frontend)
VITE_SANITY_PUBLIC_TOKEN=your_sanity_public_token_here
